{
  "name": "darvin-cowork",
  "productName": "darvin-cowork",
  "version": "1.0.0",
  "description": "Local-first desktop AI assistant. Electron + Vue 3 UI talking to a Go agent runtime over WebSocket JSON-RPC — streaming chat, tools, MCP, skills, scheduled tasks and IM channels.",
  "main": ".vite/build/main/index.js",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darven-cs/darvin-cowork.git"
  },
  "homepage": "https://github.com/darven-cs/darvin-cowork#readme",
  "bugs": {
    "url": "https://github.com/darven-cs/darvin-cowork/issues"
  },
  "scripts": {
    "prestart": "npm run build:agent && npx electron-rebuild -w better-sqlite3",
    "start": "electron-forge start",
    "build:agent": "node scripts/build-go.js",
    "premake": "npm run build:agent",
    "make": "electron-forge make",
    "package": "electron-forge package",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx,.vue .",
    "pretest": "npx node-gyp rebuild --directory=node_modules/better-sqlite3 && rm -f node_modules/better-sqlite3/build/Release/.forge-meta",
    "test": "vitest run",
    "smoke": "bash scripts/smoke.sh"
  },
  "keywords": [
    "electron",
    "vue",
    "go",
    "ai-agent",
    "assistant",
    "llm",
    "desktop",
    "local-first"
  ],
  "author": {
    "name": "darven",
    "email": "1926248272@qq.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.4.0",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/markdown-it-katex": "^1.1.2",
    "dompurify": "^3.4.12",
    "electron": "43.2.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^9.33.0",
    "katex": "^0.18.1",
    "markdown-it": "^15.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "shiki": "^4.4.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vue-eslint-parser": "^9.4.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "chokidar": "^3.6.0",
    "docx-preview": "^0.4.0",
    "electron-squirrel-startup": "^1.0.1",
    "jszip": "^3.10.1",
    "mermaid": "^11.16.0",
    "pdfjs-dist": "^6.2.108",
    "pptx-preview": "^1.0.7",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  }
}
