{
  "name": "darvin-cowork",
  "version": "1.0.0",
  "description": "",
  "main": "frontend/out/main/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "electron-vite dev frontend",
    "build": "electron-vite build frontend",
    "preview": "electron-vite preview frontend",
    "start": "electron .",
    "build:start": "npm run build && electron .",
    "start:go": "cd backend && go run ./cmd/server",
    "build:go": "cd backend && go build -o ../go-server ./cmd/server",
    "test": "vitest run --config frontend/renderer/vitest.config.ts",
    "test:watch": "vitest --config frontend/renderer/vitest.config.ts",
    "test:go": "cd backend && go test ./...",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run test:go",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.0",
    "electron-vite": "^6.0.0-beta.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.5",
    "typescript": "~6.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
